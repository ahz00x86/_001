<Page
    x:Class="UWPAPP_001.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UWPAPP_001"
    Background="Black"
    Loaded="Page_Loaded">
    
    <Grid x:Name="gMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition x:Name="c1" Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>        
        
        <!-- 11111111111111111111 -->
        
        <Image Source="/resources/imgs/_logo.png" Stretch="Fill" Grid.Row="0" Grid.Column="0"
               Width="{Binding Mode=OneWay, ElementName=svMenu, Path=ActualWidth}"
               HorizontalAlignment="Center" VerticalAlignment="Center" />

        <TextBlock Text="www...com" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center"                   
                   Padding="3" Grid.Row="0" Grid.Column="0" />

        <ScrollViewer x:Name="svMenu" Grid.Column="0" Grid.Row="1"
                      ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden">            
            <StackPanel x:Name="spMenu" Orientation="Vertical" Visibility="Visible"                    
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="3">                
            </StackPanel>
        </ScrollViewer>

        <!-- 22222222222222222222 -->
        
        <Grid x:Name="pMain" Grid.Row="1" Grid.Column="1" Padding="23" BorderThickness="3"
              BorderBrush="SkyBlue" Margin="7"
              HorizontalAlignment="Center" VerticalAlignment="Center">

            <Image x:Name="iMain" Source="/resources/imgs/EFIfam.png" Stretch="Fill"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        </Grid>

        <!-- 33333333333333333333 -->
        
            <ProgressBar x:Name="pbState" FlowDirection="LeftToRight" IsIndeterminate="False"
                         Grid.Row="2" Grid.Column="1" Margin="32"
                         Height="23" BorderBrush="White" BorderThickness="1"
                         Foreground="YellowGreen" Minimum="0" Maximum="100" Value="0" />
        
        <Image Source="/resources/imgs/_corner.png" Stretch="Fill" Grid.Row="2" Grid.Column="2"
               Width="{Binding Mode=OneWay, ElementName=svMenu, Path=ActualWidth}"
               HorizontalAlignment="Center" VerticalAlignment="Center" />

        <TextBlock x:Uid="tbCOM2" Text="www...com" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Padding="3" Grid.Row="2" Grid.Column="2" />
        
    </Grid>
</Page>
