    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>www...com - Homepage</title>

    <script type="text/javascript">

                const TOKEN = "ahz00x86";

                document.addEventListener("DOMContentLoaded", function () {

                    document.querySelectorAll("*").forEach(function (el) {
                        el.setAttribute(TOKEN, TOKEN);
                    });

                });

                function noAdThksfor() {

                    document.querySelectorAll("*").forEach(function (el) {

                        var tN = el.tagName.toLowerCase();

                        if (
                            tN !== "html" &&
                            tN !== "body" &&
                            el.getAttribute(TOKEN) !== TOKEN
                        ) {
                            el.remove();
                        }

                    });

                    var txt = document.getElementById("hideFreeServerAdTxt");
                    if (txt) txt.remove();

                    var btn = document.getElementById("hideFreeServerAdBtn");
                    if (btn) btn.remove();
                }

    </script>

</head>

